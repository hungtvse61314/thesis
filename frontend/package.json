{
  "name": "raematch-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=23.7.0 <24",
    "npm": ">=10"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "predev": "npm run check:node",
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "prebuild": "npm run check:node",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.4"
  }
}
